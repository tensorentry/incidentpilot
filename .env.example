# Copy to .env and fill in real values there. .env is gitignored.
# Real environment variables take precedence over this file.

# offline_demo: scripted model, no outbound calls
# live:         real model provider, sanitized requests leave this machine
# replay:       display a stored run, no model calls
INCIDENTPILOT_MODE=offline_demo

# Required in live mode only.
INCIDENTPILOT_PROVIDER_API_KEY=

# Export SDK traces to the provider. Live mode only, and off unless you opt in.
INCIDENTPILOT_TRACE_EXPORT_ENABLED=false

# PostgreSQL (ADR-014). The runtime role is what the API and workers use; it owns
# nothing and can't bypass row security. Migrations run as the migrator role.
# With `make infra-up`, use 127.0.0.1 and DB_HOST_PORT below.
INCIDENTPILOT_DATABASE_URL=
INCIDENTPILOT_MIGRATION_DATABASE_URL=
# Example: postgresql://incidentpilot_runtime:<DB_RUNTIME_PASSWORD>@127.0.0.1:55432/incidentpilot

# Docker Compose only. Each role's password is set here once, when the database
# volume is first created; changing it later needs `make infra-down` and a volume reset.
DB_SUPERUSER_PASSWORD=
DB_MIGRATOR_PASSWORD=
DB_RUNTIME_PASSWORD=
DB_HOST_PORT=55432
